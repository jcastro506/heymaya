# Copy to .env.local for local development. Never commit .env.local.
# Server-side keys also live in each Convex deployment's environment variables
# (npx convex env set NAME value --deployment ...). See docs/CREATOR_SPRINT_PLAN.md §20.

# --- Convex (set by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# --- Stripe (test mode locally and on staging; live only on production) ---
# §26 tiers: one Stripe price per tier and interval. Founding is a badge, not a price.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_DUO_MONTHLY=
STRIPE_PRICE_DUO_ANNUAL=
STRIPE_PRICE_PARTNER_MONTHLY=
STRIPE_PRICE_PARTNER_ANNUAL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Telegram (one bot per environment) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPERATOR_CHAT_ID=

# --- Vendors ---
SCRAPE_CREATORS_API_KEY=
GOOGLE_API_KEY=            # Gemini, direct
OPENROUTER_API_KEY=        # screener + critic only
GROQ_API_KEY=              # voice notes (Sprint 3)
ZERNIO_API_KEY=            # Sprint 4

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# --- Partnership research and user-owned Gmail (backend secrets) ---
TAVILY_API_KEY=
GMAIL_REDIRECT_URI=        # exact registered /api/gmail/callback URL
ENCRYPTION_KEY=            # base64 of 32 random bytes; deployment-specific
PARTNERSHIP_EMAIL_SEND_ENABLED=false # enable only after controlled mailbox testing
PARTNERSHIP_PILOT_CREATOR_IDS= # comma-separated creator IDs; access is denied when empty

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Ops ---
ADMIN_DASH_TOKEN=          # operator console; fail-closed when unset
ENVIRONMENT_NAME=local     # local | staging | production; stamped on every costEvents row
