# ── Convex (operator runs `npx convex dev --configure` to populate) ──────
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Google Calendar OAuth (Creator Maya v0 direct Google API) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local default. Production should be:
# https://www.hey-maya.ai/api/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3020/api/google-calendar/callback

# ── Brain (OpenRouter — Gemini 3 Flash with thinking budget) ─────────────
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash
# Thinking budget map per task is configured in convex/agents/modelRouter/maya.ts

# ── Read layer (ScrapeCreators) ──────────────────────────────────────────
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com

# ── Write layer (Composio v3) ────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://api.composio.dev
# Composio consumer key — get from dashboard.composio.dev. Plumbed into
# Maya's deploy at boot. The Fly init.cmd installs
# `@composio/openclaw-plugin` and runs
# `openclaw config set plugins.entries.composio.config.consumerKey "$COMPOSIO_CONSUMER_KEY"`
# so Maya gets every connected toolkit (TikTok / Gmail / GoogleCalendar /
# LinkedIn / X) as native runtime tools. Toolkit shape is decided in the
# Composio dashboard — the plugin has no allowlist option. OAuth lifecycle
# (connect-link generation, callback handling) stays in
# convex/integrations/composio/oauth.ts.
COMPOSIO_CONSUMER_KEY=

# ── Billing (Stripe — populated in Sprint 6) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=

# ── Agent runtime (Fly.io for OpenClaw machines — Sprint 1+) ─────────────
FLY_API_TOKEN=
FLY_ORG_SLUG=
FLY_REGION=iad

# ── Channels ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
WHATSAPP_BUSINESS_TOKEN=
# iMessage pairing is via OpenClaw native — no env var

# ── App ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3020
CRON_SECRET=

# ── Feature flags ────────────────────────────────────────────────────────
# Creator-product suppression for legacy broad creator surfaces. The focused
# `/creator-maya-v0` beta onboarding route is public either way. Default
# `false`: `/creators`, `/onboarding/maya`, and the creator HQ paths (`/today`,
# `/performance`, `/plan`, `/trends`, `/deals`, `/profile`) all 308-redirect to
# their service equivalents.
#
# Flip to `true` to restore the dual-track surface: account-type picker at
# `/`, creator marketing at `/creators`, creator onboarding at
# `/onboarding/maya`, and creator HQ screens reachable.
#
# Read by `middleware.ts` (server-side, request-time) and `app/page.tsx`
# (server-side render). Creator code, tests, schema, and Convex tables stay
# preserved regardless — this flag only controls the public surface.
NEXT_PUBLIC_ENABLE_CREATOR_PRODUCT=false

# Surface the "For businesses" audience toggle on /creators. When `false`
# (default), the toggle is hidden — creator product is the only public surface.
# Flip to `true` once the service-business landing is ready to expose. The
# /business route itself stays reachable either way; this flag only controls
# whether visitors can navigate to it from the creator landing.
NEXT_PUBLIC_ENABLE_BUSINESS_PRODUCT=false
