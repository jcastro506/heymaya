# ── Convex (operator runs `npx convex dev --configure` to populate) ──────
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Brain (OpenRouter — Gemini 3 Flash with thinking budget) ─────────────
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash
# Thinking budget map per task is configured in convex/agents/modelRouter/maya.ts

# ── Read layer (ScrapeCreators) ──────────────────────────────────────────
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com

# ── Write layer (Composio v3) ────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://api.composio.dev

# ── Billing (Stripe — populated in Sprint 6) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=

# ── Agent runtime (Fly.io for OpenClaw machines — Sprint 1+) ─────────────
FLY_API_TOKEN=
FLY_ORG_SLUG=
FLY_REGION=iad

# ── Channels ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
WHATSAPP_BUSINESS_TOKEN=
# iMessage pairing is via OpenClaw native — no env var

# ── App ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=

# ── Feature flags ────────────────────────────────────────────────────────
# Creator-product suppression. Default `false`: only the service-business
# product is publicly reachable — `/` server-renders the service landing,
# `/creators`, `/onboarding/maya`, and the creator HQ paths
# (`/today`, `/performance`, `/plan`, `/trends`, `/deals`, `/profile`)
# all 308-redirect to their service equivalents.
#
# Flip to `true` to restore the dual-track surface: account-type picker at
# `/`, creator marketing at `/creators`, creator onboarding at
# `/onboarding/maya`, and creator HQ screens reachable.
#
# Read by `middleware.ts` (server-side, request-time) and `app/page.tsx`
# (server-side render). Creator code, tests, schema, and Convex tables stay
# preserved regardless — this flag only controls the public surface.
NEXT_PUBLIC_ENABLE_CREATOR_PRODUCT=false
