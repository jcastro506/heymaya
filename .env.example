# Copy to .env.local for local development. Never commit .env.local.
# Server-side keys also live in each Convex deployment's environment variables
# (npx convex env set NAME value --deployment ...). See docs/CREATOR_SPRINT_PLAN.md §20.

# --- Convex (set by `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# --- Stripe (test mode locally and on staging; live only on production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FOUNDING_MONTHLY=
STRIPE_PRICE_FOUNDING_ANNUAL=
STRIPE_PRICE_LIST_MONTHLY=
STRIPE_PRICE_LIST_ANNUAL=

# --- Telegram (one bot per environment) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPERATOR_CHAT_ID=

# --- Vendors ---
SCRAPE_CREATORS_API_KEY=
GOOGLE_API_KEY=            # Gemini, direct
OPENROUTER_API_KEY=        # screener + critic only
GROQ_API_KEY=              # voice notes (Sprint 3)
ZERNIO_API_KEY=            # Sprint 4

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Ops ---
ADMIN_DASH_TOKEN=          # operator console; fail-closed when unset
ENVIRONMENT_NAME=local     # local | staging | production; stamped on every costEvents row
